# The expense receipts sample for one ERP, with the Velixo CLI from cli.velixo.com.
#   docker build -f Dockerfile.acumatica -t expense-receipts-acumatica .
# Pin a CLI version with --build-arg VELIXO_VERSION=0.3.1; the default is the latest release.
# Sign the CLI in once; the sign-in lives on the velixo volume:
#   docker run -it --rm -v velixo-acumatica:/data/velixo expense-receipts-acumatica velixo login --env nx-dev --no-browser
#   docker run -it --rm -v velixo-acumatica:/data/velixo expense-receipts-acumatica velixo login --complete "<redirected URL>"
# Run:
#   docker run -d --env-file .env.acumatica -v velixo-acumatica:/data/velixo -v state-acumatica:/data/state -p 8090:8090 expense-receipts-acumatica
FROM python:3.13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

ARG VELIXO_VERSION=
RUN curl -fsSL https://cli.velixo.com/install.sh | VELIXO_INSTALL_DIR=/usr/local/bin sh -s -- $VELIXO_VERSION

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app.py ./
COPY expenses ./expenses
COPY static ./static
COPY velixo ./velixo

ENV EXPENSES_ERP=acumatica \
    VELIXO_CONNECTION=demo \
    ACUMATICA_URL=https://demo.velixo.com \
    VELIXO_CONFIG_DIR=/data/velixo \
    EXPENSES_STATE=/data/state \
    PORT=8090
EXPOSE 8090

# One worker: the simulator's messages and each phone's turn-taking live in memory.
CMD ["sh", "-c", "exec gunicorn --workers 1 --threads 8 --bind 0.0.0.0:$PORT 'app:create_app()'"]
