# The expense receipts sample for one ERP, with the Velixo CLI from cli.velixo.com.
#   docker build -f Dockerfile.sageintacct -t expense-receipts-sageintacct .
# Pin a CLI version with --build-arg VELIXO_VERSION=0.3.1; the default is the latest release.
# Sign the CLI in once; the sign-in lives on the velixo volume:
#   docker run -it --rm -v velixo-sageintacct:/data/velixo expense-receipts-sageintacct velixo login --env nx-dev --no-browser
#   docker run -it --rm -v velixo-sageintacct:/data/velixo expense-receipts-sageintacct velixo login --complete "<redirected URL>"
# Run:
#   docker run -d --env-file .env.sageintacct -v velixo-sageintacct:/data/velixo -v state-sageintacct:/data/state -p 8090:8090 expense-receipts-sageintacct
FROM python:3.13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

ARG VELIXO_VERSION=
RUN curl -fsSL https://cli.velixo.com/install.sh | VELIXO_INSTALL_DIR=/usr/local/bin sh -s -- $VELIXO_VERSION

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app.py ./
COPY expenses ./expenses
COPY static ./static
COPY velixo ./velixo

ENV EXPENSES_ERP=sageintacct \
    VELIXO_CONNECTION=skyline \
    VELIXO_CONFIG_DIR=/data/velixo \
    EXPENSES_STATE=/data/state \
    PORT=8090
VOLUME ["/data/velixo", "/data/state"]
EXPOSE 8090

# One worker: the simulator's messages and each phone's turn-taking live in memory.
CMD ["sh", "-c", "exec gunicorn --workers 1 --threads 8 --bind 0.0.0.0:$PORT 'app:create_app()'"]
