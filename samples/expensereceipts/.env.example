# Which ERP the app creates expenses in: acumatica or sageintacct.
EXPENSES_ERP=acumatica
# The Velixo CLI connection to use (velixo connections list).
VELIXO_CONNECTION=demo
EXPENSES_BASE_CURRENCY=USD

# Reading receipts: an OpenRouter key, and optionally another vision model.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-opus-5.5

# Links in the reply. Acumatica: the instance address and company. Sage Intacct: a URL template with {id}.
ACUMATICA_URL=https://demo.velixo.com
ACUMATICA_COMPANY=
SAGE_EXPENSE_URL_TEMPLATE=

# Receiving texts. Leave empty to use the simulator page only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The public URL Twilio posts to, when the app runs behind a proxy or tunnel.
TWILIO_WEBHOOK_URL=

# Telegram: a bot from @BotFather, and a long random secret for its webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
